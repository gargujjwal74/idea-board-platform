server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Static SPA
    location / {
        try_files $uri /index.html;
    }

    # API reverse proxy -> backend. BACKEND_URL is injected at container start,
    # so the same image works in compose (http://backend:8000) and k8s (http://<release>-backend:8000).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
